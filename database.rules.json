{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$code": {
        ".write": "auth != null"
      }
    },
    "hands": {
      "$code": {
        ".write": "auth != null",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
